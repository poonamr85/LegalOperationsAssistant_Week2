LLM_PROVIDER=nebius
NEBIUS_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Verified in the authenticated Nebius model catalog; availability can change.
LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
EVIDENCE_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Optional, only used when LLM_PROVIDER=openai and endpoint/models are switched too.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=legal-operations-minilm-vectors
PINECONE_INDEX_HOST=
# Namespace prefix; the application appends a corpus/model hash per snapshot.
PINECONE_NAMESPACE=legal-demo

# Output limits; increase if structured responses hit the limit.
GRADE_MAX_TOKENS=700
ANSWER_MAX_TOKENS=500

# Faster failure handling: per API call, not a full workflow deadline.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
# Unique passages supplied to evidence grading.
RETRIEVAL_LIMIT=4

# One post-generation claim check; model defaults to EVIDENCE_MODEL if blank.
CLAIM_MODEL=
CLAIM_TIMEOUT_SECONDS=10
CLAIM_MAX_TOKENS=1600
